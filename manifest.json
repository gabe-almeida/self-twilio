{
  "manifest_version": 3,
  "name": "Twilio Dialer",
  "version": "1.0.0",
  "description": "Make phone calls directly from Chrome using Twilio",
  "permissions": [
    "storage",
    "declarativeContent",
    "microphone"
  ],
  "host_permissions": [
    "https://*.twilio.com/*",
    "https://*.ngrok-free.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.svg",
      "48": "assets/icons/icon48.svg",
      "128": "assets/icons/icon128.svg"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.svg",
    "48": "assets/icons/icon48.svg",
    "128": "assets/icons/icon128.svg"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["config/config.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      }
    }
  }
}