{
  "name": "twilio-dialer-server",
  "version": "1.0.0",
  "description": "Server for Twilio Dialer Web App",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node setup-ngrok.js & nodemon index.js",
    "tunnel": "node setup-ngrok.js",
    "test-error-handling": "node test-error-handling.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:file": "jest",
    "test:unit": "jest '.*\\.unit\\.test\\.js'",
    "test:integration": "jest '.*\\.integration\\.test\\.js'",
    "test:e2e": "jest --config=jest.e2e.config.js",
    "test:services": "jest 'services/.*.test.js'",
    "migrate-to-db": "node scripts/migrate-to-db.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "ngrok": "^5.0.0-beta.2",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.3",
    "twilio": "^4.19.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "babel-jest": "^29.7.0",
    "chai": "^5.2.0",
    "jest": "^29.7.0",
    "jest-puppeteer": "^9.0.2",
    "mocha": "^11.1.0",
    "nodemon": "^2.0.22",
    "puppeteer": "^22.15.0",
    "sinon": "^19.0.2",
    "sinon-chai": "^4.0.0",
    "supertest": "^7.0.0"
  }
}
