{
  "errorHandling": {
    "enabled": true,
    "retryEnabled": true,
    "maxRetries": 3,
    "failureCategorization": true
  },
  "logging": {
    "detailedErrors": true,
    "callStatusLogging": true
  },
  "concurrency": {
    "enabled": true,
    "lockTimeout": 30000,
    "retryInterval": 500,
    "maxRetries": 10,
    "distributedLocking": false,
    "autoRelease": true
  },
  "loadBalancing": {
    "enabled": true,
    "maxCallsPerMinute": 60,
    "agentCooldownMinutes": 5,
    "maxConsecutiveFailures": 3,
    "prioritizeHighPriorityCalls": true,
    "fairDistribution": true
  },
  "monitoring": {
    "enabled": true,
    "updateIntervalMs": 60000,
    "alertCheckIntervalMs": 300000,
    "metricsLogIntervalMs": 3600000,
    "alertThresholds": {
      "highCallFailureRate": 0.3,
      "highQueueDepth": 20,
      "lowAgentAvailability": 0.2,
      "highCallVolume": 50,
      "longWaitTime": 300
    }
  },
  "abTesting": {
    "enabled": true,
    "tests": {
      "callDistribution": {
        "enabled": true,
        "variants": {
          "traditional": 0.5,
          "loadBalanced": 0.5
        }
      },
      "retryStrategy": {
        "enabled": true,
        "variants": {
          "fixed": 0.3,
          "exponential": 0.7
        }
      }
    }
  },
  "scheduledCalls": {
    "enabled": true,
    "batchSize": 10,
    "batchTimeWindow": 60000,
    "optimizationEnabled": true,
    "timezone": "America/New_York"
  },
  "persistentStorage": {
    "enabled": true
  }
}